{
  "name": "crash-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.ts & vite",
    "dev:client": "vite",
    "server": "node server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "serve": "bash scripts/start.sh",
