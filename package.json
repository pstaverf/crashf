    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.0",
    "framer-motion": "^11.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "5.9",
    "vite": "^5.4.21"
  },
  "overrides": {
    "@rollup/rollup-android-arm64": "4.45.1"
  },
  "engines": {
    "node": ">=22.18"
  }
